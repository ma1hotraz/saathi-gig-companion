{
  "name": "saathi",
  "version": "1.0.0",
  "private": true,
  "description": "Saathi \u2014 a GenAI-powered, multilingual companion for gig and informal workers (earnings, safety, rights & schemes, documents, grievances).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke:live": "tsx --env-file=.env scripts/smoke.ts",
    "build:web": "vite build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-gujarati": "5.3.0",
    "@fontsource/noto-sans-gurmukhi": "5.3.0",
    "@fontsource/noto-sans-kannada": "5.3.0",
    "@fontsource/noto-sans-malayalam": "5.3.0",
    "@fontsource/noto-sans-oriya": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@fontsource/noto-sans-telugu": "5.3.0",
    "@google/genai": "2.27.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@supabase/supabase-js": "2.117.2",
    "clsx": "2.1.1",
    "compression": "1.8.2",
    "express": "5.1.0",
    "express-rate-limit": "8.7.0",
    "file-type": "22.1.1",
    "helmet": "8.1.0",
    "lru-cache": "11.2.2",
    "lucide-react": "1.50.0",
    "multer": "2.4.0",
    "pino": "9.11.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.56.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.36.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
